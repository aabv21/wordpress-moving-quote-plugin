#. Plugin Name of the plugin
msgid "Moving Quote"
msgstr "Cotizador de mudanzas"

#. Description of the plugin
msgid "Three-step moving quote form with live estimates, a leads list, and signed delivery to n8n."
msgstr "Formulario de cotización de mudanzas en tres pasos, con precio estimado al instante, listado de solicitudes y envío firmado a n8n."

#. Author of the plugin
msgid "Andrés Buelvas"
msgstr "Andrés Buelvas"

msgid "Received"
msgstr "Recibida"

msgid "Reference"
msgstr "Referencia"

msgid "Customer"
msgstr "Cliente"

