  "diagram_type": "sequence",
  "meta": {
    "title": "Lead Delivery Sequence",
    "locale": "en",
    "output": "docs/diagrams/lead-sequence.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1520, 980],
    "legend": {
      "entries": {
        "emphasis": { "label": "main path" },
        "default": { "label": "call" },
        "return": { "label": "reply" },
        "dashed": { "label": "retry loop" }
      }
    }
  },
  "participants": [
    { "id": "browser", "type": "frontend", "label": "Browser" },
    { "id": "rest", "type": "backend", "label": "REST API" },
    { "id": "wpdb", "type": "database", "label": "Leads table", "brand": "mysql" },
    { "id": "cron", "type": "backend", "label": "Cron sidecar" },
    { "id": "intake", "type": "backend", "label": "lead-intake" },
    { "id": "pg", "type": "database", "label": "Postgres", "brand": "postgresql" },
    { "id": "process", "type": "backend", "label": "process-lead" },
    { "id": "google", "type": "external", "label": "Sheets · Gmail" }
  ],
  "segments": [
    { "from": 160, "to": 250, "label": "1 Estimate" },
    { "from": 270, "to": 360, "label": "2 Submit and insert" },
    { "from": 380, "to": 420, "label": "3 Signed POST and verify" },
    { "from": 488, "to": 550, "label": "4 Record and respond" },
    { "from": 570, "to": 640, "label": "5 Hand off to process-lead" },
    { "from": 660, "to": 852, "label": "6 Retry on failure (alternative)" }
  ],
  "messages": [
    {
      "from": "browser",
      "to": "rest",
      "y": 178,
      "label": "POST /estimate (debounced)",
      "variant": "emphasis"
    },
    {
      "from": "rest",
      "to": "browser",
      "y": 206,
      "label": "amount, low, high",
      "variant": "return"
    },
    {
      "from": "browser",
      "to": "rest",
      "y": 288,
      "label": "POST /leads, X-WP-Nonce",
      "variant": "emphasis"
    },
    {
      "from": "rest",
      "to": "wpdb",
      "y": 316,
      "label": "insert by submission_id",
      "variant": "emphasis"
    },
    {
      "from": "wpdb",
      "to": "rest",
      "y": 344,
      "label": "new row, lease set",
      "variant": "return"
    },
    {
      "from": "rest",
      "to": "intake",
      "y": 398,
      "label": "Authorization: Bearer <JWT>",
      "variant": "emphasis"
    },
    {
      "from": "intake",
      "to": "pg",
      "y": 508,
      "label": "verified; INSERT ... ON CONFLICT DO NOTHING",
      "variant": "emphasis"
    },
    {
      "from": "pg",
      "to": "intake",
      "y": 536,
      "label": "event_id, or none if duplicate",
      "variant": "return"
    },
    {
      "from": "intake",
      "to": "rest",
      "y": 590,
      "label": "200 accepted / duplicate",
      "variant": "return"
    },
    {
      "from": "rest",
      "to": "browser",
      "y": 618,
      "label": "201 ok, reference, estimate",
      "variant": "return"
    },
    {
      "from": "intake",
      "to": "process",
      "y": 672,
      "label": "fire-and-forget (accepted only)",
      "variant": "emphasis"
    },
    {
      "from": "process",
      "to": "google",
      "y": 700,
      "label": "append row, then email team + customer"
    },
    {
      "from": "wpdb",
      "to": "cron",
      "y": 740,
      "label": "due rows (pending, backoff elapsed)",
      "variant": "dashed"
    },
    {
      "from": "cron",
      "to": "intake",
      "y": 768,
      "label": "same submission_id, fresh JWT",
      "variant": "dashed"
    },
    {
      "from": "intake",
      "to": "cron",
      "y": 796,
      "label": "accepted, or duplicate if the first attempt landed",
      "variant": "dashed"
    },
    {
      "from": "cron",
      "to": "wpdb",
      "y": 832,
      "label": "apply_sync: sent, or pending with new backoff",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Inside lead-intake's verify step",
      "items": [
        "Webhook's native jwtAuth rejects a bad signature or missing token first",
        "A generated Code node checks lifetime (<=300 s), body_sha256, and jti = request_uuid",
        "Read/Write Files loads config/config.json before the Postgres insert runs"
      ]
    },
    {
      "dot": "violet",
      "title": "Retry is at-least-once",
      "items": [
        "WordPress's outbox resends the same submission_id with a fresh JWT",
        "processed_events dedupes on jti, so a retried accept is read as duplicate",
        "WordPress only counts a 2xx with status accepted or duplicate as delivered"
      ]
    }
  ]
}
