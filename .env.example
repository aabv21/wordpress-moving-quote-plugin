# WordPress
WP_URL=http://localhost:8080
WP_ADMIN_USER=chivabox-admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com
# The site's default language, served without a URL prefix: en_US or es_CO. setup.sh always builds
# both languages (the other one under /es/ or /en/). SITE_LOCALE=es_CO ./setup.sh overrides it once.
SITE_LOCALE=en_US

# MySQL
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
N8N_DB_USER=n8n
N8N_DB_PASSWORD=
APP_DB_USER=app
APP_DB_PASSWORD=

# The runtime role every Postgres node connects as: DML on named tables, no DDL (docs/database.md)
APP_RUNTIME_DB_USER=app_runtime
APP_RUNTIME_DB_PASSWORD=

# n8n
N8N_ENCRYPTION_KEY=
N8N_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/

# Delivery
LEAD_WEBHOOK_SECRET=
TEAM_EMAIL=team@example.com

# Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
