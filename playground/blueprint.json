{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/aabv21/wordpress-moving-quote-plugin",
        "ref": "main",
        "refType": "branch",
        "path": "plugin/moving-quote"
      },
      "options": {
        "activate": true,
        "targetFolderName": "moving-quote"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/aabv21/wordpress-moving-quote-plugin",
        "ref": "main",
        "refType": "branch",
        "path": "site/theme"
      },
      "options": {
        "activate": true,
        "targetFolderName": "chivabox"
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Chivabox Movers",
        "blogdescription": "Moving across Colombia's Caribbean coast",
        "timezone_string": "America/Bogota",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Moving company on Colombia's Caribbean coast",
        "--post_name=home",
        "--post_excerpt=Home and office moves between Barranquilla, Cartagena and Santa Marta. See an instant estimate and book a crew.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/home\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Get a quote",
        "--post_name=get-a-quote",
        "--post_excerpt=Answer three short steps and see your moving estimate in Colombian pesos right away.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/quote\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Request received",
        "--post_name=thank-you",
        "--post_excerpt=Your moving request was received. Here is what happens next.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/thank-you\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Data processing policy",
        "--post_name=data-policy",
        "--post_excerpt=How Chivabox Movers handles the data you send with a quote request.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/data-policy\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=wp_navigation",
        "--post_status=publish",
        "--post_title=Primary navigation",
        "--post_name=primary-navigation",
        "--post_content=<!-- wp:navigation-link {\"label\":\"Get a quote\",\"url\":\"/get-a-quote/\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->"
      ]
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; $settings = get_option( 'moving_quote_settings' ); $settings = array_merge( is_array( $settings ) ? $settings : [], [ 'business_phone' => '570000000099', 'business_whatsapp' => '570000000099', 'business_street' => 'Calle 00 # 00-00', 'business_city' => 'Barranquilla', 'business_hours_open' => '07:00', 'business_hours_close' => '18:00', 'business_tax_id' => 'NIT 000.000.000-0' ] ); update_option( 'moving_quote_settings', $settings );"
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "option",
        "update",
        "show_on_front",
        "page"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "eval",
        "update_option( 'page_on_front', (int) get_page_by_path( 'home' )->ID );"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "eval",
        "update_option( 'wp_page_for_privacy_policy', (int) get_page_by_path( 'data-policy' )->ID );"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "rewrite",
        "flush",
        "--hard"
      ]
    }
  ]
}
