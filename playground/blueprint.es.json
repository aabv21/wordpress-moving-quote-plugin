{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/aabv21/wordpress-moving-quote-plugin",
        "ref": "main",
        "refType": "branch",
        "path": "plugin/moving-quote"
      },
      "options": {
        "activate": true,
        "targetFolderName": "moving-quote"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/aabv21/wordpress-moving-quote-plugin",
        "ref": "main",
        "refType": "branch",
        "path": "site/theme"
      },
      "options": {
        "activate": true,
        "targetFolderName": "chivabox"
      }
    },
    {
      "step": "setSiteLanguage",
      "language": "es_CO"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Chivabox Movers",
        "blogdescription": "Mudanzas en la costa Caribe colombiana",
        "timezone_string": "America/Bogota",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Empresa de mudanzas en la costa Caribe de Colombia",
        "--post_name=home",
        "--post_excerpt=Mudanzas de hogares y oficinas entre Barranquilla, Cartagena y Santa Marta. Vea un precio estimado al instante y reserve su cuadrilla.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/home\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Cotice su mudanza",
        "--post_name=get-a-quote",
        "--post_excerpt=Responda tres pasos cortos y vea al instante el precio estimado de su mudanza en pesos colombianos.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/quote\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Solicitud recibida",
        "--post_name=thank-you",
        "--post_excerpt=Recibimos su solicitud de mudanza. Esto es lo que sigue.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/thank-you\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=page",
        "--post_status=publish",
        "--post_title=Política de tratamiento de datos",
        "--post_name=data-policy",
        "--post_excerpt=Cómo trata Chivabox Movers los datos que envía con una solicitud de cotización.",
        "--post_content=<!-- wp:pattern {\"slug\":\"chivabox/data-policy\"} /-->"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "post",
        "create",
        "--post_type=wp_navigation",
        "--post_status=publish",
        "--post_title=Primary navigation",
        "--post_name=primary-navigation",
        "--post_content=<!-- wp:navigation-link {\"label\":\"Cotizar\",\"url\":\"/get-a-quote/\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->"
      ]
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; $settings = get_option( 'moving_quote_settings' ); $settings = array_merge( is_array( $settings ) ? $settings : [], [ 'business_phone' => '570000000099', 'business_whatsapp' => '570000000099', 'business_street' => 'Calle 00 # 00-00', 'business_city' => 'Barranquilla', 'business_hours_open' => '07:00', 'business_hours_close' => '18:00', 'business_tax_id' => 'NIT 000.000.000-0' ] ); update_option( 'moving_quote_settings', $settings );"
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "option",
        "update",
        "show_on_front",
        "page"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "eval",
        "update_option( 'page_on_front', (int) get_page_by_path( 'home' )->ID );"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "eval",
        "update_option( 'wp_page_for_privacy_policy', (int) get_page_by_path( 'data-policy' )->ID );"
      ]
    },
    {
      "step": "wp-cli",
      "command": [
        "wp",
        "rewrite",
        "flush",
        "--hard"
      ]
    }
  ]
}
