{
  "name": "wordpress-moving-quote-plugin",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/frontend/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:assets": "node scripts/build-assets.ts",
    "build:workflows": "node scripts/build-workflows.ts",
    "i18n": "node scripts/i18n.ts",
    "check": "node scripts/check-workflows.ts workflows",
    "db:migrate": "node scripts/db-migrate.ts",
    "setup": "node scripts/setup.ts",
    "export": "node scripts/export-workflows.ts",
    "test:stack": "vitest run --config vitest.stack.config.ts",
    "test:stack:wp": "vitest run --config vitest.stack.config.ts tests/stack/wp",
    "php": "docker compose run --rm --user \"$(id -u):$(id -g)\" php"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.0",
    "jiti": "^2.7.0",
    "luxon": "^3.7.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
